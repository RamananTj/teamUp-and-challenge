<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
		"-//Hibernate/Hibernate Configuration DTD 3.0//EN"
		"http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <property name="hibernate.connection.driver_class">com.mysql.cj.jdbc.Driver</property>
        <property name="hibernate.connection.password">Mymysql@123</property>
        <property name="hibernate.connection.url">jdbc:mysql://localhost:3306/tournament</property>
        <property name="hibernate.connection.username">root</property>
        <property name="hibernate.dialect">org.hibernate.dialect.MySQLDialect</property>
        <property name="hibernate.hbm2ddl.auto">update</property>
        <property name="hibernate.show_sql"> true </property>
        
        <!-- Entity registration -->
        <mapping class="com.tournament.teamupAndChallenge.entity.User"/>
        <mapping class="com.tournament.teamupAndChallenge.entity.Player"/>
        <mapping class="com.tournament.teamupAndChallenge.entity.Sport"/>
        <mapping class="com.tournament.teamupAndChallenge.entity.PlayerSport"/>
        
        <mapping class="com.tournament.teamupAndChallenge.entity.Team"/>
		<mapping class="com.tournament.teamupAndChallenge.entity.TeamMember"/>
		<mapping class="com.tournament.teamupAndChallenge.entity.Venue"/>
		<mapping class="com.tournament.teamupAndChallenge.entity.Match"/>
		<mapping class="com.tournament.teamupAndChallenge.entity.MatchParticipant"/>
		
		<mapping class="com.tournament.teamupAndChallenge.entity.Referee"/>
		<mapping class="com.tournament.teamupAndChallenge.entity.RefereeAssignment"/>
		<mapping class="com.tournament.teamupAndChallenge.entity.MatchResult"/>
		<mapping class="com.tournament.teamupAndChallenge.entity.Tournament"/>
		<mapping class="com.tournament.teamupAndChallenge.entity.TournamentParticipant"/>
		<mapping class="com.tournament.teamupAndChallenge.entity.TournamentMatch"/>
    </session-factory>
</hibernate-configuration>
